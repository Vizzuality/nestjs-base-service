{
  "name": "@vizzuality/base-service-schema",
  "version": "1.0.0-rc.5",
  "description": "Framework-free, Zod-based fetch-query schema builder and JSON:API schemas for nestjs-base-service. Zero path to @nestjs/* or typeorm — safe in a client bundle.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@vizzuality/nestjs-base-service-types": "1.0.0-rc.5"
  },
  "peerDependencies": {
    "zod": "^3.25.0"
  }
}
