{
  "name": "nestjs-base-service",
  "version": "1.0.0",
  "private": false,
  "description": "An opinionated base service for NestJS apps",
  "license": "MIT",
  "author": {
    "name": "Vizzuality",
    "email": "hello@vizzuality.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vizzuality/nestjs-base-service.git"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prepare": "prek install || true",
    "prepublishOnly": "pnpm build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "nestjs-typeorm-paginate": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@swc/core": "^1.15.40",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jsona": "^1.14.0",
    "node-mocks-http": "^1.12.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typeorm": "^0.3.29",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "class-transformer": ">=0.5.0",
    "class-validator": ">=0.14.0",
    "jsona": ">=1.12.0",
    "typeorm": "^0.3.20"
  },
  "peerDependenciesMeta": {
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "jsona": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ]
  }
}
