{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-explicit-any": "off",
    "no-empty-function": "off",
    "typescript/no-empty-function": "off"
  },
  "ignorePatterns": ["dist", "node_modules", "coverage"]
}
